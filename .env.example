# Supabase — get these from your project's API settings at supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API — server-side only
ANTHROPIC_API_KEY=

# Clerk Auth — get these from clerk.com dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/report

# ntfy — choose a unique topic name; volunteers subscribe to this topic in the ntfy app
# Use a hard-to-guess name (e.g. surgeaid-abc123) to avoid topic collisions
NTFY_TOPIC=surgeaid-alerts
NEXT_PUBLIC_NTFY_TOPIC=surgeaid-alerts
